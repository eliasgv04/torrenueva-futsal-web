---
import Layout from '../layouts/Layout.astro';
import EscenaPabellon from '../components/EscenaPabellon.astro';
import datos from '../data/patrocinadores.json';

// Todo sale de src/data/patrocinadores.json: para añadir o quitar un
// patrocinador solo hay que editar ese archivo.
interface Patrocinador {
  nombre: string;
  logo: string;
  url?: string;
  descripcion?: string;
}
type Categoria = { activo: boolean; lista: Patrocinador[] };

const CATEGORIAS = [
  { id: 'principales', titulo: 'Patrocinadores principales', etiqueta: 'Patrocinador principal' },
  { id: 'colaboradores', titulo: 'Colaboradores', etiqueta: 'Colaborador' },
  { id: 'apoyo', titulo: 'Patrocinadores', etiqueta: 'Patrocinador' },
];

const porCategoria = datos as Record<string, Categoria>;
const secciones = CATEGORIAS
  .map((c, nivel) => ({ ...c, nivel, activo: porCategoria[c.id]?.activo, lista: porCategoria[c.id]?.lista ?? [] }))
  .filter((s) => s.activo && s.lista.length > 0);

const patrocinadores = secciones.flatMap((s) =>
  s.lista.map((p) => ({
    nombre: p.nombre,
    logo: p.logo,
    url: p.url || '',
    descripcion: p.descripcion || '',
    categoria: s.etiqueta,
    nivel: s.nivel,
  })),
);

const datosEscena = JSON.stringify({ patrocinadores, escudo: '/images/Escudo.PNG' }).replace(/</g, '\\u003c');
const EMAIL = 'torrenuevafutsal2021@gmail.com';
---

<Layout
  titulo="Patrocinadores del Torrenueva Futsal"
  descripcion="Patrocinadores y colaboradores del Confecciones Carconga Torrenueva Futsal. Recorre la pared de nuestro pabellón y visita a las empresas que hacen posible el club."
>
  <section class="sponsors-hero">
    <div class="sponsors-hero-fondo" aria-hidden="true"></div>
    <div class="sponsors-hero-overlay" aria-hidden="true"></div>
    <div class="sponsors-hero-contenido contenedor">
      <p class="sponsors-label">Apoyo al club</p>
      <h1 class="sponsors-titulo">Patrocinadores</h1>
      <p class="sponsors-intro">
        Gracias a todas las empresas que hacen posible que el sueño del fútbol sala en Torrenueva
        siga más vivo que nunca. Sin su apoyo nada de esto sería posible. GRACIAS.
      </p>
    </div>
  </section>

  <section class="pabellon" aria-labelledby="pabellon-titulo">
    <div class="contenedor">
      <h2 id="pabellon-titulo" class="titulo-seccion">Nuestro pabellón</h2>
      <p class="pabellon-intro">
        Pasea por el Pabellón Municipal de Torrenueva: mira a tu alrededor, muévete por la pista
        y pulsa una valla para conocer a cada patrocinador.
      </p>

      <EscenaPabellon
        etiqueta="Pabellón en 3D con las vallas de los patrocinadores"
        ayudaRaton="Arrastra para mirar · Clic en la pista para moverte · Ctrl + rueda para avanzar"
        ayudaTactil="Desliza para mirar · Toca la pista para moverte"
        listaHref="#lista-patrocinadores"
        aviso="Tu navegador no puede mostrar el pabellón en 3D. Aquí abajo tienes a todos nuestros patrocinadores."
      >
        <p id="ayuda-teclado" class="visually-hidden">
          Pulsa Intro para ver la ficha. Usa las flechas o W, A, S, D para moverte por la pista.
        </p>
        <div class="pabellon-vallas">
          {patrocinadores.map((p, i) => (
            <button type="button" class="valla-btn" data-indice={i} aria-haspopup="dialog" aria-describedby="ayuda-teclado">
              <span class="valla-nombre">{p.nombre}</span>
            </button>
          ))}
        </div>
      </EscenaPabellon>
    </div>
  </section>

  <section class="seccion lista" id="lista-patrocinadores" aria-labelledby="lista-titulo">
    <h2 id="lista-titulo" class="titulo-seccion">Todos nuestros patrocinadores</h2>

    {secciones.map((s) => (
      <div class="sponsor-categoria">
        <h3>{s.titulo}</h3>
        <ul class={`sponsor-grid nivel-${s.nivel}`} role="list">
          {s.lista.map((p) => (
            <li>
              {p.url ? (
                <a class="sponsor-card" href={p.url} target="_blank" rel="noopener noreferrer">
                  <span class="sponsor-lona">
                    <img src={p.logo} alt={`Logo de ${p.nombre}`} class="sponsor-logo" data-logo loading="lazy" width="400" height="160" />
                  </span>
                  <span class="sponsor-nombre">{p.nombre}</span>
                  {p.descripcion && <span class="sponsor-desc">{p.descripcion}</span>}
                  <span class="sponsor-cta">Visitar web <span class="visually-hidden">(se abre en una pestaña nueva)</span></span>
                </a>
              ) : (
                <div class="sponsor-card">
                  <span class="sponsor-lona">
                    <img src={p.logo} alt={`Logo de ${p.nombre}`} class="sponsor-logo" data-logo loading="lazy" width="400" height="160" />
                  </span>
                  <span class="sponsor-nombre">{p.nombre}</span>
                  {p.descripcion && <span class="sponsor-desc">{p.descripcion}</span>}
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="seccion unete" aria-labelledby="unete-titulo">
    <div class="unete-caja">
      <p class="sponsors-label">Súmate al proyecto</p>
      <h2 id="unete-titulo">¿Quieres ser patrocinador?</h2>
      <p>
        Pon tu marca en la pared de nuestro pabellón y acompaña al club cada fin de semana.
        Escríbenos y te contamos todas las opciones.
      </p>
      <div class="unete-acciones">
        <a class="boton boton-primario" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a class="boton boton-contorno" href="https://www.instagram.com/torrenuevafutsal/" target="_blank" rel="noopener noreferrer">
          Instagram <span class="visually-hidden">(se abre en una pestaña nueva)</span>
        </a>
      </div>
    </div>
  </section>

  <dialog class="ficha" data-ficha aria-labelledby="ficha-nombre">
    <div class="ficha-cuerpo">
      <button type="button" class="ficha-cerrar" data-ficha-cerrar aria-label="Cerrar ficha">×</button>
      <div class="ficha-lona"><img data-ficha-logo alt="" /></div>
      <p class="ficha-categoria" data-ficha-categoria></p>
      <h2 class="ficha-nombre" id="ficha-nombre" data-ficha-nombre></h2>
      <p class="ficha-desc" data-ficha-desc hidden></p>
      <a class="boton boton-primario ficha-visitar" data-ficha-visitar target="_blank" rel="noopener noreferrer">Visitar</a>
    </div>
  </dialog>

  <script is:inline type="application/json" id="datos-pabellon" set:html={datosEscena}></script>
</Layout>

<script>
  import { prepararLogo } from '../scripts/logos.js';
  import { arrancarEscena } from '../scripts/pabellon/arranque.js';

  interface DatoPatrocinador {
    nombre: string;
    logo: string;
    url: string;
    descripcion: string;
    categoria: string;
    nivel: number;
  }

  const datos: { patrocinadores: DatoPatrocinador[]; escudo: string } = JSON.parse(
    document.getElementById('datos-pabellon')?.textContent || '{"patrocinadores":[]}',
  );

  // Recorta los logos y oscurece los que son blancos para que se lean sobre la lona clara.
  function adaptarLogo(img: HTMLImageElement) {
    const procesar = () => {
      if (img.dataset.procesado) return;
      img.dataset.procesado = '1';
      try {
        img.src = prepararLogo(img, { maxLado: 600 }).toDataURL('image/png');
      } catch {
        // Si el navegador no deja leer el lienzo, se queda el logo original.
      }
    };
    if (img.complete && img.naturalWidth) procesar();
    else img.addEventListener('load', procesar, { once: true });
  }
  document.querySelectorAll<HTMLImageElement>('img[data-logo]').forEach(adaptarLogo);

  // Ficha del patrocinador
  const ficha = document.querySelector<HTMLDialogElement>('[data-ficha]')!;
  const fichaLogo = ficha.querySelector<HTMLImageElement>('[data-ficha-logo]')!;
  const fichaNombre = ficha.querySelector<HTMLElement>('[data-ficha-nombre]')!;
  const fichaCategoria = ficha.querySelector<HTMLElement>('[data-ficha-categoria]')!;
  const fichaDesc = ficha.querySelector<HTMLElement>('[data-ficha-desc]')!;
  const fichaVisitar = ficha.querySelector<HTMLAnchorElement>('[data-ficha-visitar]')!;

  function abrirFicha(indice: number) {
    const p = datos.patrocinadores[indice];
    if (!p) return;
    delete fichaLogo.dataset.procesado;
    fichaLogo.alt = `Logo de ${p.nombre}`;
    fichaLogo.src = p.logo;
    adaptarLogo(fichaLogo);
    fichaNombre.textContent = p.nombre;
    fichaCategoria.textContent = p.categoria;
    fichaDesc.textContent = p.descripcion;
    fichaDesc.hidden = !p.descripcion;
    if (p.url) {
      fichaVisitar.href = p.url;
      fichaVisitar.hidden = false;
      fichaVisitar.setAttribute('aria-label', `Visitar la web de ${p.nombre} (se abre en una pestaña nueva)`);
    } else {
      fichaVisitar.hidden = true;
      fichaVisitar.removeAttribute('href');
    }
    ficha.showModal();
  }
  ficha.querySelector('[data-ficha-cerrar]')!.addEventListener('click', () => ficha.close());
  ficha.addEventListener('click', (e) => {
    if (e.target === ficha) ficha.close();
  });

  // Escena 3D
  const botones = [...document.querySelectorAll<HTMLButtonElement>('.valla-btn')];
  botones.forEach((b, i) => b.addEventListener('click', () => abrirFicha(i)));

  const { escena } = arrancarEscena({
    hayContenido: datos.patrocinadores.length > 0,
    cargar: async (ctx) => {
      const { iniciarPabellon } = await import('../scripts/pabellon/patrocinadores.js');
      return iniciarPabellon({
        contenedor: escena,
        patrocinadores: datos.patrocinadores,
        escudo: datos.escudo,
        botones,
        alAbrir: abrirFicha,
        ...ctx,
      });
    },
    alListo: (control) => {
      botones.forEach((b, i) => {
        b.addEventListener('focus', () => control.enfocar(i));
        b.addEventListener('blur', () => control.enfocar(null));
      });
    },
  });
</script>

<style>
.sponsors-hero {
  position: relative;
  overflow: hidden;
  min-height: 36vh;
  display: flex;
  align-items: center;
  background: #040404;
}
.sponsors-hero-fondo {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 20% 20%, rgba(245, 197, 24, .16), transparent 35%),
    linear-gradient(135deg, rgba(255, 255, 255, .05), transparent 45%),
    url('/images/FondoPrincipal.jpeg') center/cover no-repeat;
  filter: grayscale(100%) brightness(.34) contrast(1.05);
  transform: scale(1.03);
}
.sponsors-hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to top, rgba(4,4,4,1) 0%, rgba(4,4,4,.65) 48%, rgba(4,4,4,.2) 100%),
    linear-gradient(to right, rgba(4,4,4,.88) 0%, rgba(4,4,4,.38) 60%, transparent 100%);
}
.sponsors-hero-contenido {
  position: relative;
  z-index: 1;
  padding-top: 2.5rem;
  padding-bottom: 2rem;
}
.sponsors-label {
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--color-acento);
  margin-bottom: .9rem;
}
.sponsors-titulo {
  font-family: var(--fuente-titulo);
  font-size: clamp(3rem, 8vw, 6rem);
  font-weight: 400;
  line-height: .95;
  text-transform: uppercase;
  margin-bottom: 1rem;
}
.sponsors-intro {
  max-width: 680px;
  font-size: 1.02rem;
  color: rgba(255, 255, 255, .82);
}

/* ---------- Pabellón 3D ---------- */
.pabellon { padding: 2.5rem 0 1rem; }
.pabellon-intro {
  max-width: 720px;
  color: var(--color-texto-sec);
  margin-bottom: 1.5rem;
}
.pabellon-vallas {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  visibility: hidden;
}
:global(.pabellon-escena.is-lista) .pabellon-vallas { visibility: visible; }
.valla-btn {
  position: absolute;
  top: 0;
  left: 0;
  padding: 0;
  border: 0;
  background: transparent;
  border-radius: 4px;
  pointer-events: none;
}
.valla-btn:focus-visible {
  outline: 3px solid var(--color-acento);
  outline-offset: 5px;
}
.valla-nombre {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 12px);
  transform: translate(-50%, 6px);
  white-space: nowrap;
  padding: .35rem .8rem;
  border-radius: 999px;
  background: rgba(6, 8, 11, .9);
  border: 1px solid rgba(245, 197, 24, .55);
  color: var(--color-acento);
  font-family: var(--fuente-titulo);
  font-size: .85rem;
  letter-spacing: .06em;
  text-transform: uppercase;
  opacity: 0;
  transition: opacity .2s ease, transform .2s ease;
}
.valla-btn.is-activa .valla-nombre,
.valla-btn:focus-visible .valla-nombre {
  opacity: 1;
  transform: translate(-50%, 0);
}
.valla-btn.is-detras .valla-nombre { display: none; }

/* ---------- Lista (también es la versión 2D) ---------- */
.lista { scroll-margin-top: 90px; }
.sponsor-categoria + .sponsor-categoria { margin-top: 2.5rem; }
.sponsor-categoria h3 {
  font-family: var(--fuente-titulo);
  font-weight: 400;
  font-size: clamp(1.2rem, 2.4vw, 1.6rem);
  letter-spacing: .04em;
  text-transform: uppercase;
  color: var(--color-acento);
  margin-bottom: 1rem;
}
.sponsor-grid {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
}
.sponsor-grid.nivel-0 { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
.sponsor-card {
  display: flex;
  flex-direction: column;
  gap: .75rem;
  height: 100%;
  padding: .9rem;
  border-radius: 14px;
  background: #0c0c0c;
  border: 1px solid rgba(245, 197, 24, .28);
  color: #fff;
  text-decoration: none;
  transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
}
a.sponsor-card:hover {
  transform: translateY(-3px);
  border-color: var(--color-acento);
  box-shadow: var(--sombra-hover);
  text-decoration: none;
}
.sponsor-lona {
  position: relative;
  aspect-ratio: 5 / 2;
  border-radius: 6px;
  background: linear-gradient(#fbfbf8, #e9e9e4);
}
.sponsor-logo {
  position: absolute;
  inset: 10% 12%;
  width: 76%;
  height: 80%;
  object-fit: contain;
}
.sponsor-nombre {
  font-family: var(--fuente-titulo);
  font-size: 1rem;
  letter-spacing: .04em;
  text-transform: uppercase;
}
.sponsor-desc {
  font-size: .85rem;
  color: var(--color-texto-sec);
}
.sponsor-cta {
  margin-top: auto;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--color-acento);
}

/* ---------- ¿Quieres ser patrocinador? ---------- */
.unete-caja {
  padding: clamp(1.6rem, 4vw, 2.8rem);
  border-radius: 18px;
  border: 1px solid rgba(245, 197, 24, .35);
  background:
    radial-gradient(circle at 85% 20%, rgba(245, 197, 24, .14), transparent 45%),
    #0b0b0b;
}
.unete-caja h2 {
  font-family: var(--fuente-titulo);
  font-weight: 400;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  text-transform: uppercase;
  line-height: 1;
  margin-bottom: .9rem;
}
.unete-caja p:not(.sponsors-label) {
  max-width: 620px;
  color: var(--color-texto-sec);
  margin-bottom: 1.4rem;
}
.unete-acciones {
  display: flex;
  flex-wrap: wrap;
  gap: .75rem;
}

/* ---------- Ficha ---------- */
.ficha {
  width: min(440px, calc(100% - 2rem));
  max-height: calc(100dvh - 2rem);
  margin: auto;
  padding: 0;
  border: 1px solid rgba(245, 197, 24, .5);
  border-radius: 18px;
  background: #0b0b0b;
  color: var(--color-texto);
  box-shadow: 0 30px 80px rgba(0, 0, 0, .7);
}
.ficha::backdrop {
  background: rgba(0, 0, 0, .72);
  backdrop-filter: blur(4px);
}
.ficha-cuerpo {
  position: relative;
  display: grid;
  gap: .6rem;
  padding: 1.6rem;
  text-align: center;
}
.ficha-cerrar {
  position: absolute;
  top: .6rem;
  right: .7rem;
  width: 36px;
  height: 36px;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, .06);
  color: var(--color-texto);
  font-size: 1.4rem;
  line-height: 1;
  cursor: pointer;
}
.ficha-cerrar:hover { background: rgba(255, 255, 255, .14); }
.ficha-lona {
  position: relative;
  aspect-ratio: 5 / 2;
  margin: 1rem 0 .4rem;
  border-radius: 8px;
  background: linear-gradient(#fbfbf8, #e9e9e4);
}
.ficha-lona img {
  position: absolute;
  inset: 10% 12%;
  width: 76%;
  height: 80%;
  object-fit: contain;
}
.ficha-categoria {
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--color-acento);
}
.ficha-nombre {
  font-family: var(--fuente-titulo);
  font-weight: 400;
  font-size: 1.7rem;
  text-transform: uppercase;
  line-height: 1.05;
}
.ficha-desc { color: var(--color-texto-sec); }
.ficha-visitar { justify-self: center; margin-top: .6rem; }
.ficha-visitar[hidden] { display: none; }

@media (prefers-reduced-motion: reduce) {
  .valla-nombre,
  .sponsor-card { transition: none; }
}
</style>
