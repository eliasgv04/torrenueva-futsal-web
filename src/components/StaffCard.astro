---
interface Props {
  nombre: string;
  cargo: string;
  foto: string;
}

const { nombre, cargo, foto } = Astro.props;

const primerNombre = nombre.trim().split(/\s+/).slice(0, -1).join(' ') || nombre;
---

<article class="tarjeta staff-tarjeta">
  <div class="staff-foto-wrap">
    <img
      src={foto}
      alt={`Foto de ${nombre}`}
      class="staff-foto"
      loading="lazy"
      width="300"
      height="400"
    />
    <div class="staff-degradado" aria-hidden="true"></div>
    <div class="staff-info">
      <p class="staff-nombre">{primerNombre}</p>
      <p class="staff-cargo">{cargo}</p>
    </div>
  </div>
</article>

<style>
.staff-tarjeta {
  text-align: center;
  transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease;
}
.staff-tarjeta:hover {
  transform: translateY(-7px) scale(1.015);
  border-color: var(--club-verde);
  box-shadow:
    0 18px 38px rgba(0, 0, 0, .6),
    0 0 0 2px var(--club-amarillo),
    0 0 26px rgba(245, 197, 24, .3);
}

.staff-foto-wrap {
  position: relative;
  overflow: hidden;
  aspect-ratio: 3/4;
}
.staff-foto {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .4s ease;
  filter: grayscale(20%);
}
.staff-tarjeta:hover .staff-foto {
  transform: scale(1.06);
  filter: grayscale(0%);
}

.staff-degradado {
  position: absolute;
  inset: auto 0 0 0;
  height: 60%;
  background: linear-gradient(to top, rgba(0, 0, 0, .92) 0%, rgba(0, 0, 0, .55) 45%, transparent 100%);
  pointer-events: none;
}

.staff-info {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 .9rem .85rem;
  min-height: 1.9rem;
  display: grid;
}

.staff-nombre,
.staff-cargo {
  grid-area: 1 / 1;
  transition: opacity .25s ease;
}

.staff-nombre {
  font-family: var(--fuente-display);
  font-style: italic;
  font-size: 1.3rem;
  font-weight: 600;
  color: #fff;
  line-height: 1.3;
  opacity: 1;
}

.staff-cargo {
  align-self: center;
  font-family: var(--fuente-titulo);
  font-size: 1.15rem;
  color: var(--color-acento);
  text-transform: uppercase;
  letter-spacing: .12em;
  font-weight: 700;
  opacity: 0;
}

.staff-tarjeta:hover .staff-nombre { opacity: 0; }
.staff-tarjeta:hover .staff-cargo { opacity: 1; }
</style>
